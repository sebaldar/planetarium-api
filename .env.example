# Copiare in .env e adattare.

# Indirizzo su cui esporre la porta del container: l'IP dell'interfaccia
# WireGuard di questo host (mai 0.0.0.0/tutte le interfacce).
# In locale, senza wg attivo, sovrascrivere con 127.0.0.1.
BIND_ADDR=10.10.0.3

# Porta pubblicata sull'host (mappata sulla 8484 interna al container).
PLANETARIUM_PORT=8484

# Se impostata, il servizio richiede l'header "X-API-Key" su ogni chiamata
# (tranne /api/v1/health). Lasciare vuota per disabilitare (solo dietro
# rete privata/WireGuard fidata).
PLANETARIUM_API_KEY=
