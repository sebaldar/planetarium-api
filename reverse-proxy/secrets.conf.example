# Template — NON è il file reale. Copiare come
# /etc/nginx/secrets/planetarium.conf sulla VM proxy pubblica,
# permessi 600 root:root, e sostituire i due valori con chiavi vere
# generate con `openssl rand -hex 32` (diverse tra loro).
#
# Questo file (con i placeholder) può stare in git; la copia con i
# valori reali NO — non deve mai finire nel repo né nel vhost pubblico.
# Vedi README.md di questa cartella e la sezione "Deploy: nginx +
# WireGuard" nel README del repo planetarium-api.

set $planetarium_api_key "sostituire-con-openssl-rand-hex-32";
set $planetarium_mcp_key "sostituire-con-un-altro-openssl-rand-hex-32";
